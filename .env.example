# Sangam environment placeholders.
# Copy to `.env.local` (frontend) and `server/.env` (backend) and fill in real
# values. Never commit secrets.

# ── Frontend (Next.js, browser-safe; inlined at build time) ──────────────────
# Base URL of the Socket.IO room server. Set before `next build` for deployed
# environments, e.g. NEXT_PUBLIC_SOCKET_URL=https://sangam-api.example.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Preferred microphone pipeline:
#   auto    (default) — use the server provider when the backend advertises one,
#                        otherwise fall back to the browser's own Web Speech API.
#   server             — require the server provider; report no pipeline if absent.
#   browser            — always use the browser's Web Speech API (its per-browser
#                        limitations apply; Brave may block the service).
NEXT_PUBLIC_SPEECH_PROVIDER=auto

# ── Backend (server/, Node.js process — never exposed to the browser) ────────
# TCP port for the HTTP + Socket.IO server.
PORT=4000
# Exact browser origin(s) allowed by CORS, comma-separated for several.
# Production deployments must list real origins — wildcard (*) is refused
# when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:3000
# NODE_ENV=production

# Speech-to-text pipeline:
#   auto     (default) — use Deepgram when DEEPGRAM_API_KEY is set, else none.
#   deepgram           — require Deepgram (a missing key is a startup error).
#   mock               — deterministic double for dev/tests; never real speech.
#   none               — never run server recognition (browser/composer only).
SPEECH_PROVIDER=auto
# Deepgram credentials — server-only, never sent to the browser.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# Optional per-turn audio ceiling in bytes (default 12000000).
# SPEECH_MAX_SESSION_BYTES=12000000

# ── Server-only secrets (never prefix with NEXT_PUBLIC_) ─────────────────────
# Translation provider credentials. Consumed by a server route in a later
# phase; leave empty until that phase exists.
TRANSLATION_API_KEY=
TRANSLATION_PROVIDER_URL=
