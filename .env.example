# Sangam environment placeholders.
# Copy to `.env.local` (frontend) and `server/.env` (backend) and fill in real
# values. Never commit secrets.

# ── Frontend (Next.js, browser-safe; inlined at build time) ──────────────────
# Base URL of the Socket.IO room server. Set before `next build` for deployed
# environments, e.g. NEXT_PUBLIC_SOCKET_URL=https://sangam-api.example.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ── Backend (server/, Node.js process — never exposed to the browser) ────────
# TCP port for the HTTP + Socket.IO server.
PORT=4000
# Exact browser origin(s) allowed by CORS, comma-separated for several.
# Production deployments must list real origins — wildcard (*) is refused
# when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:3000
# NODE_ENV=production

# ── Server-only secrets (never prefix with NEXT_PUBLIC_) ─────────────────────
# Translation provider credentials. Consumed by a server route in a later
# phase; leave empty until that phase exists.
TRANSLATION_API_KEY=
TRANSLATION_PROVIDER_URL=
