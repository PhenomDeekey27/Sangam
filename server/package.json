{
  "name": "sangam-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Socket.IO real-time room server for Sangam. In-memory state: rooms are lost on restart.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
