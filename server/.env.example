# Sangam backend environment placeholders (server/.env). Never commit secrets.
#
# Copy this file to `.env` and fill in real values.

# TCP port for the HTTP + Socket.IO server.
PORT=4000
# Exact browser origin(s) allowed by CORS, comma-separated for several.
CLIENT_ORIGIN=http://localhost:3000
# NODE_ENV=production

# Speech-to-text pipeline:
#   auto     (default) — use Deepgram when DEEPGRAM_API_KEY is set, else none.
#   deepgram           — require Deepgram (a missing key is a startup error).
#   mock               — deterministic double for dev/tests; never real speech.
#   none               — never run server recognition (browser/composer only).
SPEECH_PROVIDER=auto
# Deepgram credentials — server-only, never sent to the browser.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# Machine translation order: a keyless Google endpoint fronts every utterance
# (unofficial — fast but not guaranteed, may rate-limit), with Gemini Flash
# Lite as fallback when a key is configured.
#   TRANSLATION_PROVIDER=auto   (default) — Google primary + Gemini fallback when GEMINI_API_KEY is set.
#   TRANSLATION_PROVIDER=google — Google primary only; Gemini fallback disabled (dev/test).
#   TRANSLATION_PROVIDER=gemini — Google primary + Gemini fallback required (a missing key is a startup error).
#   TRANSLATION_PROVIDER=none   — never translate; transcripts stay untranslated.
# Get a Gemini key at https://aistudio.google.com/apikey, then fill in:
TRANSLATION_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-3.5-flash-lite

# ── Translated-speech playback (Stage 6; reuses the Gemini credential) ───────
# Completed translations are synthesized on the server (never in the browser)
# and delivered only to the listener. Coverage spans every supported language,
# including Tamil, Telugu, and Hindi.
#   TTS_PROVIDER=auto   (default) — Gemini TTS when a Gemini key is set, else none.
#   TTS_PROVIDER=gemini             — require Gemini TTS (a missing key is a startup error).
#   TTS_PROVIDER=none               — never synthesize; listeners read text only.
#   TTS_API_KEY=                    — optional separate key; defaults to GEMINI_API_KEY.
#   TTS_MODEL=gemini-3.8-flash-lite-tts
#   TTS_VOICE=Kore
TTS_PROVIDER=auto
