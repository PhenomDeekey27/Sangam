# Sangam backend environment placeholders (server/.env). Never commit secrets.
#
# Copy this file to `.env` and fill in real values.

# TCP port for the HTTP + Socket.IO server.
PORT=4000
# Exact browser origin(s) allowed by CORS, comma-separated for several.
CLIENT_ORIGIN=http://localhost:3000
# NODE_ENV=production

# Sarvam AI credential, shared by speech-to-text, translation, and playback.
# Server-only: it must never appear in a NEXT_PUBLIC_* variable, a client
# bundle, a log line, or a socket payload. Leave blank to disable every Sarvam
# leg and fall back to the providers below.
SARVAM_API_KEY=

# ── Speech-to-text pipeline ──────────────────────────────────────────────────
# Priority when more than one provider is configured:
#   Sarvam Saaras → Deepgram → browser/composer.
# A failed Sarvam turn is replayed once through Deepgram with the same audio,
# so an outage never costs an utterance (and never duplicates one).
#   SPEECH_PROVIDER=auto     (default) — Sarvam when SARVAM_API_KEY is set,
#                            else Deepgram when DEEPGRAM_API_KEY is, else none.
#   SPEECH_PROVIDER=sarvam   — require Sarvam (a missing key is a startup error).
#   SPEECH_PROVIDER=deepgram — require Deepgram (a missing key is a startup error).
#   SPEECH_PROVIDER=mock     — deterministic double for dev/tests; never real speech.
#   SPEECH_PROVIDER=none     — never run server recognition (browser/composer only).
SPEECH_PROVIDER=auto
# Sarvam Saaras model (documented default `saaras:v4`).
# SARVAM_STT_MODEL=saaras:v4
# Deepgram credentials — server-only, never sent to the browser.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# ── Machine translation ──────────────────────────────────────────────────────
# Priority when more than one provider is configured:
#   Sarvam Mayura → Google → Gemini.
# Google's endpoint is keyless but unofficial (fast, not guaranteed, may
# rate-limit); Gemini Flash Lite backs it when a key is configured. Sarvam's
# catalog is Indic-only, so a non-Indic pair falls through to Google.
#   TRANSLATION_PROVIDER=auto   (default) — Sarvam when SARVAM_API_KEY is set,
#                               else Google primary; Gemini fallback when
#                               GEMINI_API_KEY is set.
#   TRANSLATION_PROVIDER=sarvam — require Sarvam (a missing key is a startup error).
#   TRANSLATION_PROVIDER=google — Google primary only; Sarvam and Gemini disabled.
#   TRANSLATION_PROVIDER=gemini — Google primary + Gemini fallback required.
#   TRANSLATION_PROVIDER=none   — never translate; transcripts stay untranslated.
# Sarvam Mayura model (documented default `mayura:v1`).
# SARVAM_TRANSLATION_MODEL=mayura:v1
# Get a Gemini key at https://aistudio.google.com/apikey, then fill in:
TRANSLATION_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-3.5-flash-lite

# ── Translated-speech playback (Stage 6) ─────────────────────────────────────
# Completed translations are synthesized on the server (never in the browser)
# and delivered only to the listener. When no server audio can be produced the
# listener is told via `conversation:playback_unavailable` and speaks the text
# with the browser's own `speechSynthesis` instead.
# Priority when more than one provider is configured:
#   Sarvam Bulbul → Gemini TTS → browser speechSynthesis.
#   TTS_PROVIDER=auto   (default) — Sarvam when SARVAM_API_KEY is set, else
#                       Gemini TTS when a Gemini key is set, else none.
#   TTS_PROVIDER=sarvam — require Sarvam Bulbul (a missing key is a startup error).
#   TTS_PROVIDER=gemini — require Gemini TTS (a missing key is a startup error).
#   TTS_PROVIDER=none   — never synthesize; listeners read text only.
#   TTS_API_KEY=        — optional separate Gemini key; defaults to GEMINI_API_KEY.
#   TTS_MODEL=gemini-3.8-flash-lite-tts
#   TTS_VOICE=Kore
# Optional Sarvam overrides; by default each language uses its documented
# Bulbul model/voice from the shared registry. A voice override replaces the
# registry voice for every supported language.
# SARVAM_TTS_MODEL=
# SARVAM_TTS_VOICE=
TTS_PROVIDER=auto
