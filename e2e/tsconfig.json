{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "incremental": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
